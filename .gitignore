# --- Secrets & local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
*.rdp
secrets/
**/secrets/
credentials*.json
!**/fixtures/**/credentials*.json

# --- Data, dumps & backups ---
# (source .sql files such as migrations ARE tracked; only dump artifacts are ignored)
*.dump.sql
*.sql.gz
*.dump
*.bak
*.backup
backups/
!infrastructure/backups/
infrastructure/backups/output/
data/
volumes/
*.sqlite
*.sqlite3
*.db

# --- Upstream checkouts (pinned by reference, not vendored) ---
upstream/
vendor-src/

# --- Node / frontend ---
node_modules/
dist/
build/
.next/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- PHP ---
/vendor/
**/vendor/
composer.phar

# --- Test artifacts ---
playwright-report/
test-results/
blob-report/

# --- Logs & OS/editor noise ---
logs/
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Caddy runtime state ---
caddy-data/
caddy-config/
