# CRM API runtime configuration (copy to .env on the host; never commit .env)
CRM_DATABASE_URL=postgres://crm_app:<password>@127.0.0.1:5433/crm
CRM_PUBLIC_ORIGIN=https://crm.<VPS_IP>.sslip.io
CRM_HOST=127.0.0.1
CRM_PORT=8810
CRM_COOKIE_SECURE=true
CRM_SESSION_TTL_HOURS=12
CRM_ATTACHMENTS_DIR=C:/srv/portfolio/crm/files
CRM_LOG_LEVEL=info

# Only needed when running scripts/migrate.ts (privileged role that is a member of crm_owner)
CRM_MIGRATION_DATABASE_URL=postgres://crm_superuser:<password>@127.0.0.1:5433/crm
