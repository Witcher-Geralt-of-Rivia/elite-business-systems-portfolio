# Elite Business Systems Portfolio — POS public site (PREPARED, NOT ACTIVE).
# Activation requires separate owner authorization (checkpoint decision POS-PUBLIC):
#   scripts/provisioning/activate-pos-public.ps1 -OwnerApproved  (preflight, backup, host-side approval flag,
#   render + validate + graceful reload, public smoke + browser tests, automatic rollback on failure).
#   render-caddy-sites.ps1 uses this file instead of pos.caddy.tmpl only while that flag exists.
# __PUBLIC_IP__ is substituted by scripts/provisioning/render-caddy-sites.ps1.

pos.__PUBLIC_IP__.sslip.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}

	root * C:/srv/portfolio/pos/app/public

	@hidden path /.* */.*
	respond @hidden 404

	request_body {
		max_size 10MB
	}

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi 127.0.0.1:9071 127.0.0.1:9072 {
		lb_policy least_conn
		lb_try_duration 5s
	}
	file_server

	log {
		output file C:/srv/portfolio/logs/caddy-pos-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Loopback listener kept after activation for local checks (portal /status/pos, monitoring): health only.
http://127.0.0.1:8820 {
	bind 127.0.0.1
	root * C:/srv/portfolio/pos/app/public
	@health path /harborpine/health
	handle @health {
		php_fastcgi 127.0.0.1:9071 127.0.0.1:9072 {
			lb_policy least_conn
			lb_try_duration 5s
		}
	}
	handle {
		respond 404
	}
}
